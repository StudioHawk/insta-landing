# Cloudflare Pages header rules.
#
# Note the zone (harrysanders.com) sets Browser Cache TTL to 4 hours, which
# overrides the Cache-Control below for stylesheets and images. That is why
# index.html loads style.css with a ?v= hash stamped at build time: a changed
# stylesheet arrives on a URL nothing has cached. These rules still apply
# where the zone does not override them, and record the intent.
/style.css
  Cache-Control: public, max-age=0, must-revalidate

/data.json
  Cache-Control: public, max-age=0, must-revalidate
